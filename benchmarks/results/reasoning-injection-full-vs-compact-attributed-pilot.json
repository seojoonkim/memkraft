    {
      "case_id": "multiples-sum",
      "task": "Find the sum of every positive integer below 10,000,000 that is divisible by 3 or 5.",
      "expected": "23333331666668",
      "lesson": "Use inclusion-exclusion. For divisor d below limit L, let m=floor((L-1)/d) and sum=d*m*(m+1)/2; add d=3 and d=5, then subtract d=15."
    },
    {
      "case_id": "factorial-zeros",
      "task": "How many trailing zeroes are in 100,000 factorial?",
      "expected": "24999",
      "lesson": "Trailing zeroes of n! equal floor(n/5)+floor(n/25)+... until the quotient is zero; no factorial expansion is needed."
    },
    {
      "case_id": "lattice-paths",
      "task": "How many shortest paths are there from one corner to the opposite corner of a 30 by 30 square grid when moves are only right or down?",
      "expected": "118264581564861424",
      "lesson": "A shortest path has 60 moves with exactly 30 right moves, so the count is the binomial coefficient C(60,30)."
    },
    {
      "case_id": "divisor-count",
      "task": "How many positive divisors does 2^12 * 3^7 * 5^4 have?",
      "expected": "520",
      "lesson": "For prime factorization product p_i^a_i, the positive-divisor count is the product of (a_i+1)."
    },
    {
      "case_id": "squares-sum",
      "task": "Find the exact sum of the squares of all integers from 1 through 100,000 inclusive.",
      "expected": "333338333350000",
      "lesson": "Use the closed form 1^2+...+n^2=n(n+1)(2n+1)/6 and perform exact integer arithmetic."
    },
    {
      "case_id": "modular-power",
      "task": "Compute the exact remainder when 7^22222 is divided by 1,000,003.",
      "expected": "345063",
      "lesson": "Use modular exponentiation by repeated squaring, reducing modulo 1,000,003 after every multiply and square."
    }
  ],
